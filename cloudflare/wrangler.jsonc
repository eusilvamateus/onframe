{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onframe-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node ../scripts/build-security-ui.js" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MELI_REDIRECT_URI": "https://onframe.onblide.com/oauth/mercadolivre/callback",
    "AUTH_EMAIL_FROM": "OnFrame <acesso@onframe.onblide.com>",
    "SUPABASE_URL": "https://ignrkxityihpvreaimxe.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_e4YLeOdiFZ7N0QIkIL7wJA_rOeaS6ux",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFIJHY8iacQ0d-dn"
  },
  "secrets": {
    "required": ["MELI_TOKEN_CIPHER_KEY_BASE64", "RESEND_API_KEY", "SUPABASE_SEND_EMAIL_HOOK_SECRET", "SUPABASE_SERVICE_ROLE_KEY"]
  },
  "routes": [
    {
      "pattern": "onframe.onblide.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "ONFRAME_DB",
      "database_name": "onframe-core",
      "database_id": "f0265ccb-826f-4839-bfb0-20bf1200c4ee",
      "migrations_dir": "migrations"
    }
  ]
}
