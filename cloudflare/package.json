{
  "name": "@onblide/onframe-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply onframe-core --local",
    "db:migrate:remote": "wrangler d1 migrations apply onframe-core --remote",
    "deploy": "wrangler deploy --keep-vars",
    "dev": "wrangler dev",
    "types": "wrangler types"
  },
  "devDependencies": {
    "miniflare": "5.20260921.0-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bowser": "2.12.1",
    "standardwebhooks": "1.0.0"
  }
}
